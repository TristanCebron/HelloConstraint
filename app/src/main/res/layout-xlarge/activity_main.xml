<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar2"
        android:layout_width="960dp"
        android:layout_height="168dp"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editTextText2"
        android:layout_width="910dp"
        android:layout_height="168dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:ems="10"
        android:inputType="text"
        android:text="HelloConstraint"
        android:textSize="96sp"
        app:layout_constraintStart_toStartOf="@+id/materialToolbar"
        app:layout_constraintTop_toTopOf="@+id/materialToolbar" />

    <Button
        android:id="@+id/button_toast2"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="260dp"
        android:layout_height="208dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="1084dp"
        android:text="@string/button_toast"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_zero2"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="254dp"
        android:layout_height="214dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="56dp"
        android:background="@color/material_dynamic_neutral10"
        android:backgroundTint="@color/material_dynamic_neutral10"
        android:text="@string/button_zero"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.43" />

    <Button
        android:id="@+id/button_count2"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="248dp"
        android:layout_height="249dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="64dp"
        android:text="@string/button_count"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.158" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="640dp"
        android:layout_height="1077dp"
        android:layout_marginStart="304dp"
        android:layout_marginTop="216dp"
        android:background="#FFEB3B"
        android:textColor="@color/design_default_color_primary_dark"
        android:textSize="96sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>